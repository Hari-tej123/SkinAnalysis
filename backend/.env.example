# Gemini API key for AI dermatologist chat assistant
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: PostgreSQL Database URL. If omitted, app defaults automatically to SQLite (skin_ai.db)
DATABASE_URL=sqlite:///./skin_ai.db
# For Docker Postgres:
# DATABASE_URL=postgresql://postgres:skin_ai_password@localhost:5432/skin_ai
